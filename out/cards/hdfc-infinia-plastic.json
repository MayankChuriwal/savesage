 "benefits": [
  {
   "name": "CLUB ITC",
   "type": "DINING_ORDER_IN",
   "description": "1+1 complimentary buffet at participating ITC Hotels",
   "offer": "Get 1+1 complimentary buffet at participating ITC Hotels with your HDFC Bank Infinia Credit Card.|Offer valid on all days with advance booking through the Concierge desk.|Only one complimentary buffet per booking, with a maximum of one booking per card per month.|Payment must be made using the HDFC Bank Infinia Credit Card.|Bookings must be made at least 48 hours prior and cannot be cancelled or modified.|Offer subject to availability of tables reserved under the program.",
   "duration": "Ongoing",
   "howToAvail": "To avail the offer, call the HDFC Infinia 24x7 Concierge at 1800 118 887 or 022 42320226 and share your preferred ITC hotel, date, and time of visit. You will receive a reservation confirmation via email. Present this email at the restaurant during your visit and make the balance payment using your HDFC Bank Infinia Credit Card. Please refer to the offer details and terms & conditions applicable.",
   "exclusion": null,
   "golfSessions": null,
   "golfDuration": null,
   "movieTickets": null,
   "movieDuration": null,
   "imageUrl": "https://d3dx7t8uh9asmu.cloudfront.net/HOTEL%20LOYALTY/clubITC.png"
  },
  {
   "name": "CLUB ITC",
   "type": "TRAVEL",
   "description": "2+1 complimentary night @ ITC Hotels",
   "offer": "Book a 3-night stay and pay for only 2 nights at participating ITC Hotels with your HDFC Bank Infinia Credit Card.|The complimentary night applies to the room rate only; taxes and additional services are to be paid by the guest.|Only one complimentary night is allowed per booking, valid exclusively for 3-night stays.",
   "duration": "Ongoing",
   "howToAvail": "To Avail this offer, click on Book Now (https://www.itchotels.com/in/en/promotions/hdfc-offer) to reserve your stay.|Present the booking confirmation at check-in and pay for the balance room nights using your HDFC Bank Infinia Credit Card.|Please review the offer details and applicable terms & conditions before availing the offer.|For cancellations, contact the booked hotel directly via email or their helpdesk number. Cancellations will be accepted as per the individual ITC Hotels’ policies.",
   "exclusion": null,
   "golfSessions": null,
   "golfDuration": null,
